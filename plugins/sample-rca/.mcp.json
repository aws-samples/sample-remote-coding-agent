{
  "mcpServers": {
    "remote-coding-agent": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aws-samples/sample-remote-coding-agent@27b2c85acc4ec7140d1830868a17996a2e2bbfca#subdirectory=mcp",
        "rca-mcp"
      ],
      "env": {
        "RCA_API_URL": "${user_config.api_url}",
        "AWS_REGION": "${user_config.aws_region}",
        "RCA_STACK_NAME": "${user_config.stack_name}"
      }
    }
  }
}
