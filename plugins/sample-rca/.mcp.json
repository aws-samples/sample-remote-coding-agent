{
  "mcpServers": {
    "remote-coding-agent": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aws-samples/sample-remote-coding-agent@70d88f132da1ceb7420d6dda6894cda7449f1a72#subdirectory=mcp",
        "rca-mcp"
      ],
      "env": {
        "RCA_API_URL": "${user_config.api_url}",
        "RCA_REGION": "${user_config.aws_region}",
        "RCA_STACK_NAME": "${user_config.stack_name}"
      }
    }
  }
}
