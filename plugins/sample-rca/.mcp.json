{
  "mcpServers": {
    "remote-coding-agent": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aws-samples/sample-remote-coding-agent@887939f5e47dd48af955b3695b976dc23771a98b#subdirectory=mcp",
        "rca-mcp"
      ],
      "env": {
        "RCA_API_URL": "${user_config.api_url}",
        "RCA_REGION": "${user_config.aws_region}",
        "RCA_STACK_NAME": "${user_config.stack_name}"
      }
    }
  }
}
