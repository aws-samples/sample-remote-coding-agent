{
  "mcpServers": {
    "remote-coding-agent": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aws-samples/sample-remote-coding-agent@c779999d9b9f565a75c61cad4fa8116f86ae9825#subdirectory=mcp",
        "rca-mcp"
      ],
      "env": {
        "RCA_API_URL": "${user_config.api_url}",
        "RCA_REGION": "${user_config.aws_region}",
        "RCA_STACK_NAME": "${user_config.stack_name}"
      }
    }
  }
}
