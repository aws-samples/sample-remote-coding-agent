{
  "mcpServers": {
    "remote-coding-agent": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aws-samples/sample-remote-coding-agent@ebc906eb03c7e307268e9c5e1929c787a2298d96#subdirectory=mcp",
        "rca-mcp"
      ],
      "env": {
        "RCA_API_URL": "${user_config.api_url}",
        "AWS_REGION": "${user_config.aws_region}",
        "RCA_STACK_NAME": "${user_config.stack_name}"
      }
    }
  }
}
